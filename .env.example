APP_NAME=Laravel
APP_ENV=local
APP_VERSION=1.00.13
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
ASSET_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MONGO_HOST=127.0.0.1
MONGO_PORT=27017
MONGO_DATABASE=restoraerp
MONGO_USERNAME=
MONGO_PASSWORD=
MONGO_AUTH_DATABASE=admin

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mailhog
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@restauraerp.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Public demo box only. With this on, GET /api/v1/demo-config hands the
# credentials below to anyone who asks - that is what lets the front prefill its
# login form for ?demo=true visitors without ever baking them into its bundle.
# Leave it false on every real install.
DEMO_MODE=false
DEMO_USERNAME="demo@restauraerp.com"
DEMO_PASSWORD="demo"

ADMIN_EMAIL="admin@restauraerp.com"
ADMIN_PASSWORD="admin9967@resp"

# ── Multi-tenancy ────────────────────────────────────────────────────────────
# The tenant provisioned on a fresh install. INSTALL_TENANT_SLUG is the
# "restaurant code" clients send as the X-Tenant-ID header, so changing it after
# deployment invalidates every configured client and every saved login.
INSTALL_TENANT_NAME="RestoraERP"
INSTALL_TENANT_SLUG="default"

# Demo box only. DemoSeeder builds these two tenants; two rather than one so the
# demo demonstrates isolation and any scoping regression is visible as one
# restaurant's data showing up in the other's dashboard.
DEMO_TENANT_SLUG="bangla-bistro"
DEMO_TENANT_SECONDARY_SLUG="spice-garden"
