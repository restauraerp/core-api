APP_NAME=Laravel
APP_ENV=local
APP_VERSION=1.00.21
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
ASSET_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MONGO_HOST=127.0.0.1
MONGO_PORT=27017
MONGO_DATABASE=restoraerp
MONGO_USERNAME=
MONGO_PASSWORD=
MONGO_AUTH_DATABASE=admin

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mailhog
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@restauraerp.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Public demo box only. With this on, GET /api/v1/demo-config hands the
# credentials below to anyone who asks - that is what lets the front prefill its
# login form for ?demo=true visitors without ever baking them into its bundle.
# Leave it false on every real install.
DEMO_MODE=false
DEMO_USERNAME="demo@restauraerp.com"
DEMO_PASSWORD="demo"

ADMIN_EMAIL="admin@restauraerp.com"
ADMIN_PASSWORD="admin9967@resp"

# ── Multi-tenancy ────────────────────────────────────────────────────────────
# The tenant provisioned on a fresh install. INSTALL_TENANT_SLUG is the
# "restaurant code" clients send as the X-Tenant-ID header, so changing it after
# deployment invalidates every configured client and every saved login.
INSTALL_TENANT_NAME="RestoraERP"
INSTALL_TENANT_SLUG="default"

# Demo box only. The single tenant DemoSeeder builds, and the only tenant
# `php artisan demo:refresh` destroys and rebuilds - every other tenant on the
# box is somebody's real restaurant, so this slug is the whole blast radius.
DEMO_TENANT_SLUG="bangla-bistro"

# Demo tenants from an earlier shape of the demo, swept up by `demo:refresh` so
# older boxes converge on one demo restaurant. Comma-separated. Safe to empty
# once every box has refreshed at least once.
DEMO_LEGACY_TENANT_SLUGS="spice-garden"

# ── Billing & subscriptions ──────────────────────────────────────────────────
# Days of full access a new tenant gets. A trial has NO grace period: the day it
# ends the restaurant goes read-only.
BILLING_TRIAL_DAYS=7

# Days of continued full access after a paid subscription's end date. A yearly
# renewal usually goes through an invoice and a bank transfer rather than a card
# charge, so it gets longer.
BILLING_GRACE_MONTHLY=7
BILLING_GRACE_YEARLY=14

# Subscription state is resolved on every request, so it is cached. Pinned to
# redis rather than the default store: CACHE_STORE is unset on these boxes, so
# the default is `database` - a query back on the path this cache removes.
BILLING_CACHE_STORE=redis
BILLING_CACHE_TTL=900

# Shown to a restaurant whose write was refused for billing reasons, so they are
# told who to pay rather than only that it failed. These are RestoraERP's own
# contacts, not the restaurant's.
SUPPORT_EMAIL="support@restauraerp.com"
SUPPORT_PHONE=
SUPPORT_WHATSAPP=
BILLING_URL="https://restauraerp.com/#pricing"

# Shared secret the marketing website uses for /api/v1/platform/*. Must match
# the website's CORE_API_PLATFORM_TOKEN. Generate with: openssl rand -hex 32
PLATFORM_API_TOKEN=
PLATFORM_LOGIN_LINK_TTL_HOURS=24

# Marketing site, for server-to-server calls (branded emails, relayed conversion
# events), so it must be reachable FROM this container: use the compose service
# name locally (http://website:8030), and the public URL in production.
WEBSITE_URL=

# The same site as a customer's browser sees it, used for the "renew
# subscription" link. Leave empty wherever it is the same as WEBSITE_URL
# (production is); locally it must be http://localhost:8030, because a browser
# cannot resolve the compose service name and the link would silently go nowhere.
WEBSITE_PUBLIC_URL=

# The admin front. Used for CORS and to build the login links handed to a
# newly provisioned tenant, so a wrong port here sends real customers to a
# dead URL. Local dev runs the front on 3029; production is the public app URL.
FRONTEND_URL=

PAGINATION_LIMIT=15
