<?xml version="1.0"?>
<ruleset name="RestoraERP-CoreAPI">
    <description>PSR-12 Code Style Ruleset for RestoraERP Core API</description>

    <!-- Scan these paths -->
    <file>app</file>
    <file>config</file>
    <file>routes</file>
    <file>tests</file>

    <!-- Exclusions -->
    <exclude-pattern>*/vendor/*</exclude-pattern>
    <exclude-pattern>*/storage/*</exclude-pattern>
    <exclude-pattern>*/bootstrap/cache/*</exclude-pattern>
    <exclude-pattern>*/database/migrations/*</exclude-pattern>
    <exclude-pattern>*.blade.php</exclude-pattern>

    <!-- Show progress, colors, and sniff names -->
    <arg value="p"/>
    <arg value="s"/>
    <arg name="colors"/>

    <!-- Use PSR-12 as standard -->
    <rule ref="PSR12">
        <exclude name="PSR12.Files.FileHeader"/>
        <exclude name="PSR12.Operators.OperatorSpacing.NoSpaceBefore"/>
        <exclude name="PSR12.Operators.OperatorSpacing.NoSpaceAfter"/>
    </rule>

    <!-- Allow snake_case in test methods for PHPUnit -->
    <rule ref="PSR1.Methods.CamelCapsMethodName">
        <exclude-pattern>*/tests/*</exclude-pattern>
    </rule>

    <!-- Line length guidance -->
    <rule ref="Generic.Files.LineLength">
        <properties>
            <property name="lineLimit" value="160"/>
            <property name="absoluteLineLimit" value="0"/>
            <property name="ignoreComments" value="true"/>
        </properties>
    </rule>
</ruleset>
